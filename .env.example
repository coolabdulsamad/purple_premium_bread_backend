# --- Database (Neon PostgreSQL) ---
DB_USER=your_db_user
DB_HOST=your_db_host
DB_DATABASE=purple_premium_bread_db
DB_PASSWORD=your_db_password
DB_PORT=5432

# --- Auth ---
# REQUIRED in production. Signing and verification both read this one value.
JWT_SECRET=change_this_to_a_long_random_string

# --- Server ---
PORT=5000

# --- ImgBB image hosting (products, riders, payment proofs) ---
IMGBB_API_KEY=your_imgbb_api_key

# --- Finance ---
# Tax rate used by the Profit & Loss report (0.30 = 30%)
TAX_RATE=0.30

# --- AI assistant (online mode; offline mode needs nothing) ---
AI_API_KEY=
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini

# --- WhatsApp Cloud API (feature can also be configured from the Settings page) ---
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
